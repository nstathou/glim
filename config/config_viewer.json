{
  // Standard viewer settings
  // viewer_(width|height)    : Default viewer window size
  // default_z_range          : Default z-range for the viewer
  // enable_partial_rendering : If true, enable partial rendering. In the partial render mode, only a part of the submaps is rendered every frame, and accumulated through multiple frames
  //                          : This can be useful for real-time visualization on low-end GPUs but introduces some glitches
  // partial_rendering_budget : Number of points to render per frame
  "standard_viewer": {
    "viewer_width": 2560,
    "viewer_height": 1440,
    "default_z_range": [
      -2.0,
      4.0
    ],
    "enable_partial_rendering": false,
    "partial_rendering_budget": 1024,
    "point_shape_circle": true,
    "point_size_metric": true,
    "point_size": 0.025,
    "points_alpha": 0.5,
    "factors_alpha": 0.5,
    // Coordinate axes (length, radius) in meters
    // submap_keyframe_axis : Global mapping submaps (one per keyframe with passthrough sub_mapping)
    // window_axis          : Odometry frames in the smoother window
    // current_axis         : Latest odometry frame
    "submap_keyframe_axis": [1.0, 0.05],
    "window_axis": [0.5, 0.01],
    "current_axis": [1.5, 0.05],
    // Line widths in pixels of the trajectories and the global mapping factors (odometry + loop closure edges)
    "traj_width": 2.0,
    "factors_width": 1.0
  },
  "interactive_viewer": {
    "viewer_width": 2560,
    "viewer_height": 1440,
    "default_z_range": [
      -2.0,
      4.0
    ],
    "enable_partial_rendering": false,
    "partial_rendering_budget": 1024,
    "point_shape_circle": true,
    "point_size_metric": true,
    "point_size": 0.025,
    "points_alpha": 0.5,
    "factors_alpha": 0.5
  }
}