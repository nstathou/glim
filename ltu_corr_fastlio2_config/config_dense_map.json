{
  /*** Dense map export (glim_ext libdense_map.so) ***
  // Requires keep_raw_points=true in config_ros.json. On exit writes <dump>/<submap>/dense_scans.bin and <dump>/dense_map.pcd.
  // min_range / max_range       : Range filter [m] (max_range <= 0 disables the far limit)
  // enable_cropbox_filter       : Drop points inside the box (LiDAR frame), e.g. the robot body
  // enable_outlier_removal      : Per-scan statistical outlier removal (k neighbors, mean + std_mul * std)
  // scan_voxel_resolution       : Voxel grid [m] applied to each deskewed scan (also stored in dense_scans.bin); 0 = off
  // map_voxel_resolution        : Voxel grid [m] applied to the merged dense_map.pcd; 0 = off (full resolution)
  // max_queue_size              : Offline playback is throttled while more scans than this wait to be processed
  */
  "dense_map": {
    "min_range": 1.0,
    "max_range": 80.0,
    "enable_cropbox_filter": true,
    "crop_bbox_min": [-1.5, -1.5, -1.0],
    "crop_bbox_max": [1.5, 1.5, 1.0],
    "enable_outlier_removal": true,
    "outlier_removal_k": 8,
    "outlier_std_mul_factor": 1.0,
    "scan_voxel_resolution": 0.02,
    "map_voxel_resolution": 0.02,
    "num_threads": 2,
    "max_queue_size": 20
  }
}
