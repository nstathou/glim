{
  /*** GlobalMappingPoseGraph (two-tier) ***
  // Tier 1 (online): sparse pose graph over submaps, explicit loop detection, batch LM when loops arrive.
  // Tier 2 (on save): GLIM-style dense VGICP refinement between all overlapping submaps, initialized with the tier 1 estimate.
  // See config/config_global_mapping_pose_graph.json for the base parameters.
  //
  // odom_{rot,trans}_stddev[_per_m]  : Odometry factor sigmas = base + per_m * distance between submap origins
  // loop_use_registration_hessian    : Loop information = registration Hessian scaled so its strongest direction has loop_factor_stddev
  // loop_factor_robust_type          : HUBER (convex, keeps large true corrections) or CAUCHY (rejects outliers harder)
  // loop_batch_max_iterations        : Batch LM iterations over the whole pose graph when new loops arrive (0 = iSAM2 only)
  // refine_*                         : Dense refinement on save (refine_max_iterations = 0 disables)
  */
  "global_mapping": {
    "so_name": "libglobal_mapping_pose_graph.so",
    "enable_optimization": true,
    "init_pose_damping_scale": 1e6,
    // Loop detection: drift at revisits reaches 1-3 m, submaps are ~3 m apart
    // GICP: 2 m VGICP loop measurements were off by 0.2-0.3 m and let false loops through (end error 0.2-0.35 m)
    "registration_type": "GICP",
    "min_travel_dist": 30.0,
    "max_neighbor_dist": 5.0,
    "min_inliear_fraction": 0.6,
    "subsample_target": 10000,
    "gicp_max_correspondence_dist": 1.0, // 0.5 lost the end loop once when odom drift reached 2.6 m
    "vgicp_voxel_resolution": 2.0,
    // Odometry factors: ~1% translation and ~0.06 deg/m rotation drift on top of the base sigmas
    "odom_rot_stddev": 1e-3,
    "odom_rot_stddev_per_m": 1e-3,
    "odom_trans_stddev": 0.01,
    "odom_trans_stddev_per_m": 0.01,
    // Odometry is least reliable in fast turns (up to 100 deg in 2 s near the end of the bag): sigmas also grow per radian
    "odom_rot_stddev_per_rad": 0.02,
    "odom_trans_stddev_per_rad": 0.05,
    // Loop factors
    "loop_factor_stddev": 0.05,
    // Rotation block of the loop information is scaled separately (sharing 0.05 as rad left loop rotations ~3 deg weak)
    "loop_rot_stddev": 0.01,
    "loop_use_registration_hessian": true,
    "loop_factor_robust_type": "HUBER",
    "loop_factor_robust_width": 1.0,
    "loop_candidate_buffer_size": 100,
    "loop_candidate_eval_per_thread": 2,
    "loop_batch_max_iterations": 100,
    // Optimizer settings
    "use_isam2_dogleg": false,
    "isam2_relinearize_skip": 1,
    "isam2_relinearize_thresh": 0.1,
    // Dense refinement on save
    "refine_max_iterations": 50, // tier 1 already places the submaps; 500 once ran 14 min without gain
    "refine_rounds": 5,
    "refine_voxel_resolution": 0.1,
    "refine_voxelmap_levels": 3,
    "refine_voxelmap_scaling_factor": 2.0,
    "refine_randomsampling_rate": 0.2,
    "refine_min_overlap": 0.20,
    "refine_max_distance": 10.0,
    // Refinement keeps the odometry chain stiff (sigma / 10): tier 1 already placed the submaps
    "refine_odom_information_scale": 100.0,
    "save_merged_pcd": true,
    "merged_pcd_voxel_resolution": 0.005,
    "num_threads": 4
  }
}
